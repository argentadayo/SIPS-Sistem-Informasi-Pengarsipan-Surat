{
  "name": "api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --env-file=../../.env --hot src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "start": "bun run --env-file=../../.env dist/index.js",
    "db:generate": "bun --env-file=../../.env x prisma generate",
    "db:migrate": "bun --env-file=../../.env x prisma migrate dev",
    "db:push": "bun --env-file=../../.env x prisma db push",
    "db:seed": "bun run --env-file=../../.env prisma/seed.ts",
    "db:studio": "bun --env-file=../../.env x prisma studio"
  },
  "dependencies": {
    "@arsip/shared": "workspace:*",
    "@hono/zod-validator": "^0.4.3",
    "@prisma/client": "^6.5.0",
    "exceljs": "^4.4.0",
    "hono": "^4.7.5",
    "pdf-lib": "^1.17.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "bun-types": "1.3.14",
    "prisma": "^6.5.0",
    "typescript": "^5.8.2"
  }
}
