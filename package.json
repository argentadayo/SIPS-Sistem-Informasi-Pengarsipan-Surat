{
  "name": "arsip-surat",
  "version": "1.0.0",
  "private": true,
  "description": "Sistem Arsip Surat Masuk & Surat Keluar - Hono + React + Bun",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter api dev & bun run --filter web dev",
    "dev:api": "bun run --filter api dev",
    "dev:web": "bun run --filter web dev",
    "build": "bun run --filter api build && bun run --filter web build",
    "start:api": "bun run --filter api start",
    "db:generate": "bun run --filter api db:generate",
    "db:migrate": "bun run --filter api db:migrate",
    "db:push": "bun run --filter api db:push",
    "db:seed": "bun run --filter api db:seed",
    "db:studio": "bun run --filter api db:studio",
    "docker:up": "docker compose -f docker-compose.sips.yml up -d --build",
    "docker:down": "docker compose -f docker-compose.sips.yml down",
    "docker:logs": "docker compose -f docker-compose.sips.yml logs -f --tail=100",
    "docker:seed": "docker compose -f docker-compose.sips.yml exec api bun run prisma/seed.ts",
    "docker:db": "docker compose -f docker-compose.sips.yml up -d mysql-sips"
  },
  "packageManager": "bun@1.3.14"
}
